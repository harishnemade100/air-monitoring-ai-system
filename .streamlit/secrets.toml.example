# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Cloud, paste these lines into: App settings -> Secrets.
WAQI_TOKEN = "your_waqi_token"
OPENWEATHER_KEY = "your_openweather_key"
GEOAPIFY_KEY = "your_geoapify_key"
DATABASE_URL = "postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Optional: AI advisory with Groq (without it, a rule-based advisory is used)
GROQ_API_KEY = "gsk_your_groq_key"
LLM_MODEL = "openai/gpt-oss-120b"
